rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'phoneNumber', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'phoneNumber', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.uid == request.auth.uid &&
        data.phoneNumber is string && data.phoneNumber.size() <= 20 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('role' in data) || data.role in ['user', 'admin']);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().phoneNumber == existing().phoneNumber;
      allow delete: if false;
    }
  }
}
