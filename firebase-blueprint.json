{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with phone number authentication and addresses",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "phoneNumber": { "type": "string", "maxLength": 20 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "phoneNumber", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores private user account information indexed by Firebase Auth UID"
    }
  }
}
